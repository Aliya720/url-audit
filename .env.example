# PulseWatch Environment Variables — TRD §11
# Copy this to .env and fill in real values
# NEVER commit the real .env file

# Django
DJANGO_SECRET_KEY=change-me-to-a-random-secret-key
DEBUG=True
ALLOWED_HOSTS=localhost,127.0.0.1

# Database
DATABASE_URL=postgres://postgres:postgres@db:5432/pulsewatch

# Redis
REDIS_URL=redis://redis:6379/0
CELERY_BROKER_URL=redis://redis:6379/1

# Cache
CACHE_TTL_SECONDS=900

# Fetch
FETCH_TIMEOUT_SECONDS=10
MAX_CONCURRENT_CHECKS=50
MAX_REDIRECT_HOPS=5

# Rate Limiting
RATE_LIMIT_MAX_REQUESTS=60
RATE_LIMIT_WINDOW_SECONDS=60
RATE_LIMIT_BURST=100

# Monitor
MONITOR_MIN_INTERVAL_SECONDS=60
MONITOR_HISTORY_MAX=50

# Logging
LOG_LEVEL=INFO

# Sentry (leave empty in local dev / CI)
SENTRY_DSN=
SENTRY_ENVIRONMENT=development

# Prometheus
PROMETHEUS_METRICS_ENABLED=True

# Postgres (used by docker-compose db service)
POSTGRES_DB=pulsewatch
POSTGRES_USER=postgres
POSTGRES_PASSWORD=postgres
